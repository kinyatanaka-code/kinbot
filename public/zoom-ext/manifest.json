{
  "manifest_version": 3,
  "name": "kinbot 補助（Zoomサインイン・メールワイズ）",
  "version": "1.3.1",
  "description": "kincallで借りたZoomアカウントのサインインを自動で進めます。kinXsで作ったメールの下書きをメールワイズに入れ、メールワイズのメールを読んでkinXsのタスク作りに使います（ネオキャリア社内用）。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://kinbot-production-225f.up.railway.app/*",
    "https://accounts.google.com/*",
    "https://*.okta.com/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "https://*.cybozu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kinbot-production-225f.up.railway.app/*"
      ],
      "js": [
        "kincall.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://accounts.google.com/*"
      ],
      "js": [
        "fill.js",
        "google.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.okta.com/*"
      ],
      "js": [
        "fill.js",
        "okta.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.cybozu.com/m/*"
      ],
      "js": [
        "mailwise.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}