{
  "manifest_version": 3,
  "name": "kinbot-ext",
  "version": "1.6.1",
  "description": "kinbot の拡張機能：kincall の Zoom アカウントのサインイン補助、kinXs の下書きをメールワイズへ入れる、メールワイズのメールを読んで kinXs のタスク作りに使う（ネオキャリア社内用）。",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://kinbot-production-225f.up.railway.app/*",
    "https://accounts.google.com/*",
    "https://*.okta.com/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "https://*.cybozu.com/*",
    "https://*.miitel.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kinbot-production-225f.up.railway.app/*"
      ],
      "js": [
        "kincall.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://accounts.google.com/*"
      ],
      "js": [
        "fill.js",
        "google.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.okta.com/*"
      ],
      "js": [
        "fill.js",
        "okta.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.cybozu.com/m/*"
      ],
      "js": [
        "mailwise.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.miitel.com/app/*"
      ],
      "js": [
        "miitel-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.miitel.com/app/*"
      ],
      "js": [
        "miitel.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}