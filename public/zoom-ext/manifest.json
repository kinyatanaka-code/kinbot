{
  "manifest_version": 3,
  "name": "kinbot-ext",
  "version": "2.2.25",
  "description": "kinbot の拡張機能：kincall の Zoom アカウントのサインイン補助、kinXs の下書きをメールワイズへ入れる、メールワイズのメールを読んで kinXs のタスク作りに使う、MiiTel・Bales Cloud の画面から kinbot に取り込む、NeoSTAGE の取引申請の欄を SF から埋める、DOC の AI の管理画面で開いた候補者のチャットを kinXs に貯める・その管理画面の2段階認証の確認コードを Gmail から入れる（ネオキャリア社内用）。",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://kinbot-production-225f.up.railway.app/*",
    "https://accounts.google.com/*",
    "https://*.okta.com/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "https://*.cybozu.com/*",
    "https://*.miitel.com/*",
    "https://*.balescloud.jp/*",
    "https://neo-crm.net/*",
    "https://casual-interview-api.brainverse-ai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kinbot-production-225f.up.railway.app/*"
      ],
      "js": [
        "kincall.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://accounts.google.com/*"
      ],
      "js": [
        "fill.js",
        "google.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.okta.com/*"
      ],
      "js": [
        "fill.js",
        "okta.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.cybozu.com/m/*"
      ],
      "js": [
        "mailwise.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.miitel.com/app/*"
      ],
      "js": [
        "miitel-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.miitel.com/app/*"
      ],
      "js": [
        "miitel.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.balescloud.jp/*"
      ],
      "js": [
        "bales-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.balescloud.jp/*"
      ],
      "js": [
        "bales.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://neo-crm.net/*"
      ],
      "js": [
        "neostage.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://casual-interview-api.brainverse-ai.com/*"
      ],
      "js": [
        "docai-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://casual-interview-api.brainverse-ai.com/*"
      ],
      "js": [
        "docai.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://casual-interview-api.brainverse-ai.com/*"
      ],
      "js": [
        "twofa.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
